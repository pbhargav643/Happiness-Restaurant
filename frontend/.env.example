# Frontend Production Environment Variables Template
# Set to your production HTTPS backend API in production environments:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# For local development:
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RESTAURANT_NAME="HAPPINESS RESTAURANT"
VITE_PICKUP_ONLY=true

# Development QR Destination Network Base URL (replace with local network IP for mobile scanning)
# Production default falls back to https://happiness-restaurant-three.vercel.app
VITE_QR_BASE_URL=http://192.168.31.94:3000

