# Server Configuration
PORT=5000
# Production: NODE_ENV=production / Development: NODE_ENV=development
NODE_ENV=development
# Production: Set to your production frontend HTTPS URL (e.g., https://yourdomain.com)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=

# Authentication Configuration
# Generate a cryptographically secure 256-bit secret for production (e.g. via openssl rand -base64 32)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Initial Administrator Seed Configuration (Idempotent: Only seeds if 0 admins exist)
ADMIN_NAME=Admin Manager
ADMIN_EMAIL=
ADMIN_PASSWORD=

# WhatsApp Notification Provider Configuration (Phase 13)
# Supported providers: 'META', 'TWILIO', 'GENERIC_REST'
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=
WHATSAPP_TEMPLATE_NAMESPACE=
WHATSAPP_READY_TEMPLATE=

# SMS Notification Provider Configuration (Phase 13)
# Supported providers: 'TWILIO', 'FAST2SMS', 'MSG91', 'GENERIC_REST'
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_SENDER=

